{
  "langfuse-export": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node hooks/langfuse/session-start.ts",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/langfuse/stop.ts",
        "timeout": 15
      }
    ]
  }
}
