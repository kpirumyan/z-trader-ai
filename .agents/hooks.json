{
  "auto-fix": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/auto-fix/index.ts",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "langfuse-export": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node hooks/langfuse/session-start.ts",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/langfuse/stop.ts",
        "timeout": 5
      }
    ]
  }
}
