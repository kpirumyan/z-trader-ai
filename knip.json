{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".agents/hooks/langfuse/langfuse-stop-hook.ts",
    "src/composition/widgets.ts",
    "src/modules/*/index.ts",
    "src/shared/*/index.ts"
  ],
  "ignoreDependencies": ["agent-browser"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error"
  }
}
