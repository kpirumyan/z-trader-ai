{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".agents/hooks/auto-fix/index.ts",
    ".agents/hooks/langfuse/session-start.ts",
    ".agents/hooks/langfuse/stop.ts",
    ".agents/hooks/safety-gate/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/modules/indicators/**!",
    "src/modules/indicators/**/*.{ts,tsx}",
    ".agents/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}"
  ],
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": true,
  "ignoreDependencies": ["agent-browser"]
}
